// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  SUPERVISOR
  TEAMLEAD
  SUPERADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SUBMITTED
}

enum TaskMediaType {
  IMAGE
  VIDEO
}



model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdTasks   Task[]        @relation("CreatedTasks")
  reviewedTasks  Task[]        @relation("ReviewedTasks")
}

model DataCollector {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique
  password         String   // Stored bcrypt hash
  telegramUsername   String?
  telegramChatId   String?  @unique

  collectorTasks   CollectorTask[]

  submissions      Submission[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Task {
  id            String        @id @default(cuid())
  title         String
  description   String?
  videoCount    Int?
  imageCount    Int?
  isAssigned    Boolean       @default(false)
  isActive      Boolean       @default(true)
  status        SubmissionStatus @default(PENDING)
  createdById   String
  reviewedById  String?
  reviewerNote  String?


  createdBy     User          @relation("CreatedTasks", fields: [createdById], references: [id])
  reviewedBy     User?         @relation("ReviewedTasks", fields: [reviewedById], references: [id])

  submissions   Submission[]

  collectorTask  CollectorTask[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}


model CollectorTask {
  id            String         @id @default(cuid())
  collectorId   String
  taskId       String

  collector     DataCollector  @relation(fields: [collectorId], references: [id])
  task         Task            @relation(fields: [taskId], references: [id])

  createdAt    DateTime @default(now())

  @@unique([collectorId, taskId])
  @@index([taskId])
}

model Submission {
  id             String           @id @default(cuid())
  taskId         String
  collectorId   String
  mediaType     TaskMediaType
  uploadUrl     String?

  task           Task          @relation(fields: [taskId], references: [id])
  collector      DataCollector @relation(fields: [collectorId], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

}


model DataCollectorState {
  id              String   @id @default(cuid())
  collectorId     String   @unique
  collectorChatId String?  @unique
  currentTaskId   String?
  state           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
